{
  "name": "stripe-webhook-mcp",
  "version": "0.1.0",
  "description": "Let AI coding agents capture, inspect, and replay Stripe webhook events via MCP — no dashboard.",
  "scripts": {
    "dev": "tsx src/cli.ts mcp",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "fixture": "tsx --env-file-if-exists=.env examples/webhook-fixture.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3598644/stripe-webhook-mcp.git"
  },
  "keywords": [
    "stripe",
    "webhook",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "debugging"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/3598644/stripe-webhook-mcp/issues"
  },
  "homepage": "https://github.com/3598644/stripe-webhook-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^13.0.3",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "bin": {
    "stripe-webhook-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
